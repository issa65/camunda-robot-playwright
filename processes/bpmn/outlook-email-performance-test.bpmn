    <bpmn:serviceTask id="Activity_17at8ik" name="RPA: Outlook E-Mail E2E" zeebe:modelerTemplate="camunda.connectors.rpa" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="={&#10;  label: if (camundaRpaWorkerLabel = null or camundaRpaWorkerLabel = &#34;&#34;) then &#34;default&#34; else camundaRpaWorkerLabel,&#10;  baseName: &#34;camunda::RPA-Task::&#34;,&#10;  definitionType: baseName + label&#10;}.definitionType" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="default" target="camundaRpaWorkerLabel" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="camunda::enablePreRun" value="false" />
          <zeebe:property name="camunda::postRun" value="false" />
        </zeebe:properties>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="RPA_1egodkc" resourceType="RPA" linkName="RPAScript" />
        </zeebe:linkedResources>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0c1walw</bpmn:incoming>
      <bpmn:outgoing>Flow_07c2kmw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Activity_0e3miat" name="E-Mail Performance bewerten">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="outlookEmailPerformance" resultVariable="performanceStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07c2kmw</bpmn:incoming>
      <bpmn:outgoing>Flow_0jau0c6</bpmn:outgoing>

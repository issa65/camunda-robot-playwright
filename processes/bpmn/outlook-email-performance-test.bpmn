    <bpmn:serviceTask id="Activity_17at8ik" name="RPA: Outlook E-Mail E2E" zeebe:modelerTemplate="camunda.connectors.rpa" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="={&#10;  label: if (camundaRpaWorkerLabel = null or camundaRpaWorkerLabel = &#34;&#34;) then &#34;default&#34; else camundaRpaWorkerLabel,&#10;  baseName: &#34;camunda::RPA-Task::&#34;,&#10;  definitionType: baseName + label&#10;}.definitionType" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="laptop" target="camundaRpaWorkerLabel" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="camunda::enablePreRun" value="false" />
          <zeebe:property name="camunda::postRun" value="false" />
        </zeebe:properties>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="RPA_1ybo8d0" resourceType="RPA" linkName="RPAScript" />
        </zeebe:linkedResources>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0c1walw</bpmn:incoming>
      <bpmn:outgoing>Flow_0czpcac</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Activity_0e3miat" name="E-Mail Performance bewerten">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="outlookEmailPerformance" resultVariable="performanceStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yd7kv3</bpmn:incoming>
      <bpmn:outgoing>Flow_1pfc66i</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Activity_17mn37g" name="Alert / E-Mail" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="4" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="host.docker.internal" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="=1025" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="camunda-monitor@test.local" target="data.smtpAction.from" />
          <zeebe:input source="ahmad@test.local" target="data.smtpAction.to" />
          <zeebe:input source="=&#34;Outlook E2E Performance &#34; + performanceStatus" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=&#34;Outlook E2E Performance Alert&#10;&#10;Status: &#34; + performanceStatus +&#10;&#34;&#10;Test ID: &#34; + testId +&#10;&#34;&#10;Subject: &#34; + subject +&#10;&#34;&#10;Delivery Duration: &#34; + string(deliveryDurationSeconds) + &#34; s&#34; +&#10;&#34;&#10;Total E2E Duration: &#34; + string(totalE2EDurationSeconds) + &#34; s&#34;" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="4" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hh54g2</bpmn:incoming>
      <bpmn:outgoing>Flow_06350wb</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0fgwvl7" name="Testergebnis speichern">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-test-result" />
        <zeebe:ioMapping>
          <zeebe:input source="=testId" target="testRunId" />
          <zeebe:input source="=&#34;Outlook Email Performance&#34;" target="testName" />
          <zeebe:input source="=&#34;TECHNICAL&#34;" target="testType" />
          <zeebe:input source="=&#34;Outlook&#34;" target="component" />
          <zeebe:input source="=if emailSent = true and emailReceived = true&#10;then &#34;PASS&#34;&#10;else &#34;FAIL&#34;" target="result" />
          <zeebe:input source="=if testResult = &#34;FAIL&#34; then &#34;ERROR&#34; else performanceStatus" target="status" />
          <zeebe:input source="=totalE2EDurationSeconds" target="durationSeconds" />
          <zeebe:input source="=&#34;Outlook email E2E performance test&#34;" target="message" />
          <zeebe:input source="=workerUser" target="workerUser" />
          <zeebe:input source="=workerHost" target="workerHost" />
          <zeebe:input source="=errorType" target="errorType" />
          <zeebe:input source="=workerIpAddress" target="workerIpAddress" />
          <zeebe:input source="=errorMessage" target="errorMessage" />
          <zeebe:input source="=deliveryDurationSeconds" target="deliveryDurationSeconds" />
          <zeebe:input source="=startupToLoadingSeconds" target="startupToLoadingSeconds" />
          <zeebe:input source="=loadingToMainSeconds" target="loadingToMainSeconds" />
          <zeebe:input source="=startupToMainSeconds" target="startupToMainSeconds" />
          <zeebe:input source="=startupPath" target="startupPath" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>

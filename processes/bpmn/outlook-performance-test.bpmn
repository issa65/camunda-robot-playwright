    <bpmn:businessRuleTask id="Activity_0jzzk3x" name="Performance bewerten">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="outlookPerformanceD" resultVariable="performanceStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ju9wqa</bpmn:incoming>
      <bpmn:outgoing>Flow_179nuxd</bpmn:outgoing>

    <bpmn:serviceTask id="Activity_19v7eg9" name="Alert / E-Mail" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="4" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="host.docker.internal" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="=1025" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="camunda-monitor@test.local" target="data.smtpAction.from" />
          <zeebe:input source="ahmad@test.local" target="data.smtpAction.to" />
          <zeebe:input source="=&#34;Outlook Performance &#34; + performanceStatus" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=&#34;Outlook Performance Alert&#10;&#10;Status: &#34; + performanceStatus +&#10;&#34;&#10;Startup Duration: &#34; + string(outlookStartupDuration) + &#34; s&#34; +&#10;&#34;&#10;Startup Type: &#34; + outlookStartupType +&#10;&#34;&#10;Window: &#34; + outlookWindowTitle +&#10;&#34;&#10;Measured At: &#34; + outlookMeasuredAt" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="4" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17vacfn</bpmn:incoming>
      <bpmn:outgoing>Flow_15f5hwg</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>

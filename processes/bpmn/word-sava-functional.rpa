{
  "id": "RPA_1rvy2z5",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    Camunda\nLibrary    WordLibrary\n\nTask Setup       Ensure Word Closed\nTask Teardown    Close Word\n\n\n*** Tasks ***\nWord Save Functional Test\n    ${testRunId}=          Set Variable    ${EMPTY}\n\n    ${workerUser}=         Set Variable    ${EMPTY}\n    ${workerHost}=         Set Variable    ${EMPTY}\n    ${workerIpAddress}=    Set Variable    ${EMPTY}\n\n    ${testResult}=         Set Variable    FAIL\n    ${status}=             Set Variable    ${EMPTY}\n    ${errorType}=          Set Variable    ${EMPTY}\n    ${errorMessage}=       Set Variable    ${EMPTY}\n\n    ${durationSeconds}=    Set Variable    ${EMPTY}\n\n    ${filePath}=           Set Variable    ${EMPTY}\n    ${fileName}=           Set Variable    ${EMPTY}\n    ${fileSizeBytes}=      Set Variable    ${EMPTY}\n    ${fileSaved}=          Set Variable    ${False}\n\n\n    # ---------------------------------------------------------\n    # Functional Test starten\n    # ---------------------------------------------------------\n    ${startTime}=    Evaluate\n    ...    __import__('time').perf_counter()\n\n\n    TRY\n        # -----------------------------------------------------\n        # Test-ID\n        # -----------------------------------------------------\n        ${testRunId}=    Generate Test Id\n\n\n        # -----------------------------------------------------\n        # Worker-Metadaten\n        # -----------------------------------------------------\n        ${environment}=    Get Execution Environment\n\n        ${workerUser}=    Set Variable\n        ...    ${environment}[workerUser]\n\n        ${workerHost}=    Set Variable\n        ...    ${environment}[workerHost]\n\n        ${workerIpAddress}=    Set Variable\n        ...    ${environment}[workerIpAddress]\n\n\n        # -----------------------------------------------------\n        # Zielpfad\n        # -----------------------------------------------------\n        ${filePath}=    Set Variable\n        ...    //ISSA/Gemeinsame Dateien/test-files/word-${testRunId}.docx\n\n\n        # -----------------------------------------------------\n        # Word öffnen\n        # -----------------------------------------------------\n        Open Word\n        # Datei -> Neu -> Leeres Dokument\n        #Create Blank Word Document\n\n        # -----------------------------------------------------\n        # Testinhalt schreiben\n        # -----------------------------------------------------\n        ${testText}=    Set Variable\n        ...    Camunda RPA Word Save Test ${testRunId}\n\n        Write Word Text    ${testText}\n\n\n        # -----------------------------------------------------\n        # Datei -> Speichern unter -> Durchsuchen -> Speichern\n        # -----------------------------------------------------\n        ${saveResult}=    Save Word File As\n        ...    ${filePath}\n        ...    timeout=30\n\n        ${fileSaved}=    Set Variable\n        ...    ${saveResult}[saved]\n\n        ${fileName}=    Set Variable\n        ...    ${saveResult}[fileName]\n\n        ${fileSizeBytes}=    Set Variable\n        ...    ${saveResult}[fileSizeBytes]\n\n\n        # -----------------------------------------------------\n        # Fachliche Validierung\n        # -----------------------------------------------------\n        Should Be True    ${fileSaved}\n\n        Should Be True\n        ...    ${fileSizeBytes} > 0\n\n\n        # -----------------------------------------------------\n        # Ergebnis\n        # -----------------------------------------------------\n        ${testResult}=    Set Variable    PASS\n\n        ${status}=    Set Variable\n        ...    FUNCTIONAL_OK\n\n\n    EXCEPT    AS    ${error}\n        ${testResult}=    Set Variable    FAIL\n\n        ${status}=    Set Variable\n        ...    FUNCTIONAL_ERROR\n\n        ${errorType}=    Set Variable\n        ...    TestExecutionError\n\n        ${errorMessage}=    Convert To String\n        ...    ${error}\n\n\n    FINALLY\n        # -----------------------------------------------------\n        # Dauer immer berechnen - PASS oder FAIL\n        # -----------------------------------------------------\n        ${endTime}=    Evaluate\n        ...    __import__('time').perf_counter()\n\n        ${durationSeconds}=    Evaluate\n        ...    round(float($endTime) - float($startTime), 3)\n\n\n        # -----------------------------------------------------\n        # Standardisierte Outputs\n        # -----------------------------------------------------\n        Set Output Variable    testRunId\n        ...    ${testRunId}\n\n        Set Output Variable    workerUser\n        ...    ${workerUser}\n\n        Set Output Variable    workerHost\n        ...    ${workerHost}\n\n        Set Output Variable    workerIpAddress\n        ...    ${workerIpAddress}\n\n        Set Output Variable    testResult\n        ...    ${testResult}\n\n        Set Output Variable    status\n        ...    ${status}\n\n        Set Output Variable    errorType\n        ...    ${errorType}\n\n        Set Output Variable    errorMessage\n        ...    ${errorMessage}\n\n        Set Output Variable    durationSeconds\n        ...    ${durationSeconds}\n\n\n        # -----------------------------------------------------\n        # Word-Save-spezifische Outputs\n        # -----------------------------------------------------\n        Set Output Variable    fileSaved\n        ...    ${fileSaved}\n\n        Set Output Variable    filePath\n        ...    ${filePath}\n\n        Set Output Variable    fileName\n        ...    ${fileName}\n\n        Set Output Variable    fileSizeBytes\n        ...    ${fileSizeBytes}\n\n    END"
}
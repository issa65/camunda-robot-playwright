{
  "id": "RPA_1j7s2k1",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    Camunda\nLibrary    PowerPointLibrary\n\nTask Setup       Ensure Powerpoint Closed\nTask Teardown    Close Powerpoint\n\n\n*** Tasks ***\nPowerPoint Save Functional Test\n    # ---------------------------------------------------------\n    # Initial values\n    # ---------------------------------------------------------\n    ${testRunId}=          Set Variable    ${EMPTY}\n\n    ${workerUser}=         Set Variable    ${EMPTY}\n    ${workerHost}=         Set Variable    ${EMPTY}\n    ${workerIpAddress}=    Set Variable    ${EMPTY}\n\n    ${testResult}=         Set Variable    FAIL\n    ${status}=             Set Variable    FUNCTIONAL_ERROR\n\n    ${errorType}=          Set Variable    ${EMPTY}\n    ${errorMessage}=       Set Variable    ${EMPTY}\n\n    ${durationSeconds}=    Set Variable    ${EMPTY}\n\n    ${filePath}=           Set Variable    ${EMPTY}\n    ${fileName}=           Set Variable    ${EMPTY}\n    ${fileSaved}=          Set Variable    ${False}\n    ${fileSizeBytes}=      Set Variable    ${EMPTY}\n\n\n    # ---------------------------------------------------------\n    # Functional duration\n    # Setup / Teardown intentionally excluded\n    # ---------------------------------------------------------\n    ${startTime}=    Evaluate\n    ...    __import__('time').perf_counter()\n\n\n    TRY\n        # -----------------------------------------------------\n        # Test ID\n        # -----------------------------------------------------\n        ${testRunId}=    Generate Test Id\n\n\n        # -----------------------------------------------------\n        # Worker information\n        # -----------------------------------------------------\n        ${environment}=    Get Execution Environment\n\n        ${workerUser}=    Set Variable\n        ...    ${environment}[workerUser]\n\n        ${workerHost}=    Set Variable\n        ...    ${environment}[workerHost]\n\n        ${workerIpAddress}=    Set Variable\n        ...    ${environment}[workerIpAddress]\n\n\n        # -----------------------------------------------------\n        # Target file\n        # -----------------------------------------------------\n        ${filePath}=    Set Variable\n        ...    //ISSA/Gemeinsame Dateien/test-files/powerpoint-${testRunId}.pptx\n\n\n        # -----------------------------------------------------\n        # Open PowerPoint\n        # -----------------------------------------------------\n        Open Powerpoint\n\n\n        # -----------------------------------------------------\n        # Save PowerPoint\n        # Save Powerpoint File As ensures that a blank\n        # presentation is open when PowerPoint is on start page.\n        # -----------------------------------------------------\n        ${saveResult}=    Save Powerpoint File As\n        ...    ${filePath}\n        ...    timeout=30\n\n\n        # -----------------------------------------------------\n        # Save result\n        # -----------------------------------------------------\n        ${fileSaved}=    Set Variable\n        ...    ${saveResult}[saved]\n\n        ${fileName}=    Set Variable\n        ...    ${saveResult}[fileName]\n\n        ${fileSizeBytes}=    Set Variable\n        ...    ${saveResult}[fileSizeBytes]\n\n\n        # -----------------------------------------------------\n        # Validation\n        # -----------------------------------------------------\n        Should Be True\n        ...    ${fileSaved}\n\n        Should Be True\n        ...    ${fileSizeBytes} > 0\n\n\n        # -----------------------------------------------------\n        # PASS only AFTER all steps and validations succeeded\n        # -----------------------------------------------------\n        ${testResult}=    Set Variable    PASS\n        ${status}=        Set Variable    FUNCTIONAL_OK\n\n\n    EXCEPT    AS    ${error}\n        ${testResult}=    Set Variable    FAIL\n        ${status}=        Set Variable    FUNCTIONAL_ERROR\n\n        ${errorType}=    Set Variable\n        ...    TestExecutionError\n\n        ${errorMessage}=    Convert To String\n        ...    ${error}\n\n\n    FINALLY\n        # -----------------------------------------------------\n        # Duration is always calculated, also on FAIL\n        # -----------------------------------------------------\n        ${endTime}=    Evaluate\n        ...    __import__('time').perf_counter()\n\n        ${durationSeconds}=    Evaluate\n        ...    round(float($endTime) - float($startTime), 3)\n\n\n        # -----------------------------------------------------\n        # Standard outputs\n        # -----------------------------------------------------\n        Set Output Variable    testRunId             ${testRunId}\n\n        Set Output Variable    workerUser            ${workerUser}\n        Set Output Variable    workerHost            ${workerHost}\n        Set Output Variable    workerIpAddress       ${workerIpAddress}\n\n        Set Output Variable    testResult            ${testResult}\n        Set Output Variable    status                ${status}\n\n        Set Output Variable    durationSeconds       ${durationSeconds}\n\n        Set Output Variable    errorType             ${errorType}\n        Set Output Variable    errorMessage          ${errorMessage}\n\n\n        # -----------------------------------------------------\n        # File outputs\n        # -----------------------------------------------------\n        Set Output Variable    filePath              ${filePath}\n        Set Output Variable    fileName              ${fileName}\n        Set Output Variable    fileSaved             ${fileSaved}\n        Set Output Variable    fileSizeBytes         ${fileSizeBytes}\n\n    END"
}
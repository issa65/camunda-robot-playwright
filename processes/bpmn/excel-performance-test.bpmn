      <bpmn:outgoing>Flow_1k8g6v3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_03igioh" name="PASS" sourceRef="Gateway_0p81c4n" targetRef="Activity_0h7or4j">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=testResult = "PASS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0r86cc1" sourceRef="Activity_0h7or4j" targetRef="Activity_0anjtaj" />
    <bpmn:sequenceFlow id="Flow_1k8g6v3" name="FAIL" sourceRef="Gateway_0p81c4n" targetRef="Activity_0anjtaj">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=testResult = "FAIL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Activity_1mn0pj6" name="Performance prüfen">
      <bpmn:incoming>Flow_04fgh47</bpmn:incoming>
      <bpmn:outgoing>Flow_0dgwj84</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_04fgh47" name="WARNING" sourceRef="Gateway_090psj2" targetRef="Activity_1mn0pj6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=performanceStatus = "WARNING"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0ixvelw">
      <bpmn:incoming>Flow_0dgwj84</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0dgwj84" sourceRef="Activity_1mn0pj6" targetRef="Event_0ixvelw" />
    <bpmn:sequenceFlow id="Flow_1xnegyb" name="CRITICAL" sourceRef="Gateway_090psj2" targetRef="Activity_0ycfuu6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=performanceStatus = "CRITICAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0ycfuu6" name="Alert E-Mail" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="4" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="host.docker.internal" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="=1025" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="camunda-monitor@test.local" target="data.smtpAction.from" />
          <zeebe:input source="ahmad@test.local" target="data.smtpAction.to" />
          <zeebe:input source="=&#34;Excel E2E Performance &#34; + performanceStatus" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=string join([&#10;  &#34;Excel Performance Test&#34;,&#10;  &#34;&#34;,&#10;  string join([&#34;Result: &#34;, testResult], &#34;&#34;),&#10;  string join([&#34;Performance status: &#34;, status], &#34;&#34;),&#10;  &#34;&#34;,&#10;  string join([&#34;Startup to loading: &#34;, string(startupToLoadingSeconds), &#34; s&#34;], &#34;&#34;),&#10;  string join([&#34;Loading to main: &#34;, string(loadingToMainSeconds), &#34; s&#34;], &#34;&#34;),&#10;  string join([&#34;Startup to main: &#34;, string(startupToMainSeconds), &#34; s&#34;], &#34;&#34;),&#10;  string join([&#34;Startup path: &#34;, startupPath], &#34;&#34;),&#10;  &#34;&#34;,&#10;  string join([&#34;Worker: &#34;, workerHost], &#34;&#34;),&#10;  string join([&#34;User: &#34;, workerUser], &#34;&#34;),&#10;  string join([&#34;IP: &#34;, workerIpAddress], &#34;&#34;),&#10;  string join([&#34;Test Run ID: &#34;, testRunId], &#34;&#34;)&#10;], &#34;\n&#34;)" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="4" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xnegyb</bpmn:incoming>
      <bpmn:outgoing>Flow_02vqxxy</bpmn:outgoing>
    </bpmn:serviceTask>

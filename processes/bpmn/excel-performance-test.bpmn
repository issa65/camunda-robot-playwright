    <bpmn:sequenceFlow id="Flow_1mqr78t" sourceRef="Activity_06wkxb1" targetRef="Gateway_0p81c4n" />
    <bpmn:serviceTask id="Activity_06wkxb1" name="RPA: Excel Performance" zeebe:modelerTemplate="camunda.connectors.rpa" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="={&#10;  label: if (camundaRpaWorkerLabel = null or camundaRpaWorkerLabel = &#34;&#34;) then &#34;default&#34; else camundaRpaWorkerLabel,&#10;  baseName: &#34;camunda::RPA-Task::&#34;,&#10;  definitionType: baseName + label&#10;}.definitionType" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="vm" target="camundaRpaWorkerLabel" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="camunda::enablePreRun" value="false" />
          <zeebe:property name="camunda::postRun" value="false" />
        </zeebe:properties>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="RPA_1bmmbl4" resourceType="RPA" linkName="RPAScript" />
        </zeebe:linkedResources>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fuap5c</bpmn:incoming>
      <bpmn:outgoing>Flow_1mqr78t</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0anjtaj" name="Testergebnis speichern">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-test-result" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;TECHNICAL&#34;" target="testType" />
          <zeebe:input source="=&#34;Excel&#34;" target="component" />
          <zeebe:input source="=testResult" target="result" />
          <zeebe:input source="=testRunId" target="testRunId" />
          <zeebe:input source="=&#34;Excel Startup Performance&#34;" target="testName" />
          <zeebe:input source="=if testResult = &#34;FAIL&#34; then &#34;ERROR&#34; else performanceStatus" target="status" />
          <zeebe:input source="=durationSeconds" target="durationSeconds" />
          <zeebe:input source="=&#34;Excel cold startup performance measurement&#34;" target="message" />
          <zeebe:input source="=[]" target="metrics" />
          <zeebe:input source="=workerUser" target="workerUser" />
          <zeebe:input source="=workerHost" target="workerHost" />
          <zeebe:input source="=workerIpAddress" target="workerIpAddress" />
          <zeebe:input source="=errorType" target="errorType" />
          <zeebe:input source="=errorMessage" target="errorMessage" />
          <zeebe:input source="=startupToLoadingSeconds" target="startupToLoadingSeconds" />
          <zeebe:input source="=loadingToMainSeconds" target="loadingToMainSeconds" />
          <zeebe:input source="=startupToMainSeconds " target="startupToMainSeconds" />
          <zeebe:input source="=startupPath" target="startupPath" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0r86cc1</bpmn:incoming>
      <bpmn:incoming>Flow_1k8g6v3</bpmn:incoming>
      <bpmn:outgoing>Flow_1mj7ktw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1mj7ktw" name="OK" sourceRef="Activity_0anjtaj" targetRef="Gateway_090psj2" />
    <bpmn:businessRuleTask id="Activity_0h7or4j" name="Excel Performance bewerten">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_0gl6t7v" resultVariable="performanceStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03igioh</bpmn:incoming>
      <bpmn:outgoing>Flow_0r86cc1</bpmn:outgoing>
    </bpmn:businessRuleTask>

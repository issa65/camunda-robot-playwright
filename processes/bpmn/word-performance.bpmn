    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0y653sa" name="OK" sourceRef="Gateway_1okwuqk" targetRef="Event_05a7qfr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=performanceStatus = "OK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Activity_0gz2pk1" name="Perfomance prüfen">
      <bpmn:incoming>Flow_1j36kfd</bpmn:incoming>
      <bpmn:outgoing>Flow_1itsypv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1j36kfd" name="WARNING" sourceRef="Gateway_1okwuqk" targetRef="Activity_0gz2pk1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=performanceStatus = "WARNING"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_11ahyo8">
      <bpmn:incoming>Flow_1itsypv</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1itsypv" sourceRef="Activity_0gz2pk1" targetRef="Event_11ahyo8" />
    <bpmn:sequenceFlow id="Flow_0m7ti0s" name="CRITICAL" sourceRef="Gateway_1okwuqk" targetRef="Activity_0ycfuu6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=performanceStatus = "CRITICAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0ycfuu6" name="Alert E-Mail" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="4" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="host.docker.internal" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="=1025" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="camunda-monitor@test.local" target="data.smtpAction.from" />
          <zeebe:input source="ahmad@test.local" target="data.smtpAction.to" />
          <zeebe:input source="=&#34;Excel E2E Performance &#34; + performanceStatus" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=string join([&#10;  &#34;Word Performance Test&#34;,&#10;  &#34;&#34;,&#10;  string join([&#34;Result: &#34;, testResult], &#34;&#34;),&#10;  string join([&#34;Performance status: &#34;, status], &#34;&#34;),&#10;  &#34;&#34;,&#10;  string join([&#34;Startup to loading: &#34;, string(startupToLoadingSeconds), &#34; s&#34;], &#34;&#34;),&#10;  string join([&#34;Loading to main: &#34;, string(loadingToMainSeconds), &#34; s&#34;], &#34;&#34;),&#10;  string join([&#34;Startup to main: &#34;, string(startupToMainSeconds), &#34; s&#34;], &#34;&#34;),&#10;  string join([&#34;Startup path: &#34;, startupPath], &#34;&#34;),&#10;  &#34;&#34;,&#10;  string join([&#34;Worker: &#34;, workerHost], &#34;&#34;),&#10;  string join([&#34;User: &#34;, workerUser], &#34;&#34;),&#10;  string join([&#34;IP: &#34;, workerIpAddress], &#34;&#34;),&#10;  string join([&#34;Test Run ID: &#34;, testRunId], &#34;&#34;)&#10;], &#34;\n&#34;)" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="4" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0m7ti0s</bpmn:incoming>
      <bpmn:outgoing>Flow_07vumgq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0rg117j">
      <bpmn:incoming>Flow_07vumgq</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_07vumgq" sourceRef="Activity_0ycfuu6" targetRef="Event_0rg117j" />
  </bpmn:process>

<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_138wayy" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_1sgpf5i" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1lx4ca2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1lx4ca2" sourceRef="StartEvent_1" targetRef="Activity_0dfeg5r" />
    <bpmn:serviceTask id="Activity_0dfeg5r" name="RPA: Word Performance" zeebe:modelerTemplate="camunda.connectors.rpa" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="={&#10;  label: if (camundaRpaWorkerLabel = null or camundaRpaWorkerLabel = &#34;&#34;) then &#34;default&#34; else camundaRpaWorkerLabel,&#10;  baseName: &#34;camunda::RPA-Task::&#34;,&#10;  definitionType: baseName + label&#10;}.definitionType" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="vm" target="camundaRpaWorkerLabel" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="camunda::enablePreRun" value="false" />
          <zeebe:property name="camunda::postRun" value="false" />
        </zeebe:properties>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="RPA_0ierx9m" resourceType="RPA" linkName="RPAScript" />
        </zeebe:linkedResources>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1lx4ca2</bpmn:incoming>
      <bpmn:outgoing>Flow_0c5n34x</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Activity_15wbsbv" name="Word Performance bewerten">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_1qrinbz" resultVariable="performanceStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0jxlffk</bpmn:incoming>
      <bpmn:outgoing>Flow_1o4nq5n</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_19l4mhi">
      <bpmn:incoming>Flow_0c5n34x</bpmn:incoming>
      <bpmn:outgoing>Flow_0jxlffk</bpmn:outgoing>
      <bpmn:outgoing>Flow_1jyjmh8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0c5n34x" sourceRef="Activity_0dfeg5r" targetRef="Gateway_19l4mhi" />
    <bpmn:sequenceFlow id="Flow_0jxlffk" name="PASS" sourceRef="Gateway_19l4mhi" targetRef="Activity_15wbsbv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=testResult = "PASS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0anjtaj" name="Testergebnis speichern">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-test-result" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;TECHNICAL&#34;" target="testType" />
          <zeebe:input source="=&#34;Word&#34;" target="component" />
          <zeebe:input source="=testResult" target="result" />
          <zeebe:input source="=testRunId" target="testRunId" />
          <zeebe:input source="=&#34;Word Startup Performance&#34;" target="testName" />
          <zeebe:input source="=if testResult = &#34;FAIL&#34; then &#34;ERROR&#34; else performanceStatus" target="status" />
          <zeebe:input source="=durationSeconds" target="durationSeconds" />
          <zeebe:input source="=&#34;Word cold startup performance measurement&#34;" target="message" />
          <zeebe:input source="=[]" target="metrics" />
          <zeebe:input source="=workerUser" target="workerUser" />
          <zeebe:input source="=workerHost" target="workerHost" />
          <zeebe:input source="=workerIpAddress" target="workerIpAddress" />
          <zeebe:input source="=errorType" target="errorType" />
          <zeebe:input source="=errorMessage" target="errorMessage" />
          <zeebe:input source="=startupToLoadingSeconds" target="startupToLoadingSeconds" />
          <zeebe:input source="=loadingToMainSeconds" target="loadingToMainSeconds" />
          <zeebe:input source="=startupToMainSeconds " target="startupToMainSeconds" />
          <zeebe:input source="=startupPath" target="startupPath" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1jyjmh8</bpmn:incoming>
      <bpmn:incoming>Flow_1o4nq5n</bpmn:incoming>
      <bpmn:outgoing>Flow_1famgl9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1jyjmh8" name="FAIL" sourceRef="Gateway_19l4mhi" targetRef="Activity_0anjtaj">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=testResult = "FAIL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1o4nq5n" sourceRef="Activity_15wbsbv" targetRef="Activity_0anjtaj" />

{
  "id": "RPA_1egodkc",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    Camunda\nLibrary    OutlookLibrary\n\nTask Setup       Ensure Outlook Closed\nTask Teardown    Close Outlook\n\n*** Tasks ***\nOutlook Email E2E Test\n    # Outlook öffnen und bekannte Störfenster behandeln\n    ${outlookTitle}=    Open Outlook\n    ${uiPreparation}=    Prepare Outlook Ui\n\n    # Erst danach beginnt die eigentliche E2E-Messung\n    ${e2eStart}=    Evaluate    __import__('time').perf_counter()\n\n    ${testId}=    Generate Test Id\n\n    ${subject}=    Set Variable\n    ...    Camunda RPA E2E ${testId}\n\n    ${composeTitle}=    Open New Email\n\n    ${result}=    Fill Outlook Email\n    ...    recipient=ahmad325issa@hotmail.com\n    ...    cc=ahmad325issa@hotmail.com\n    ...    subject=${subject}\n    ...    body=Automatisierter Camunda RPA E2E Test. Test ID: ${testId}\n\n    ${sendResult}=    Send Outlook Email\n\n    ${receiveResult}=    Wait For Outlook Email\n    ...    ${subject}\n    ...    ${sendResult}[sendStarted]\n    ...    timeout=90\n\n    ${e2eEnd}=    Evaluate    __import__('time').perf_counter()\n\n    ${totalDuration}=    Evaluate\n    ...    round(${e2eEnd} - ${e2eStart}, 3)\n\n    Set Output Variable    testId    ${testId}\n    Set Output Variable    subject    ${subject}\n    Set Output Variable    recipient    ${result}[recipient]\n\n    Set Output Variable    emailSent    ${sendResult}[sent]\n    Set Output Variable    emailReceived    ${receiveResult}[received]\n\n    Set Output Variable\n    ...    onboardingPopupHandled\n    ...    ${uiPreparation}[onboardingHandled]\n\n    Set Output Variable\n    ...    licensePopupHandled\n    ...    ${uiPreparation}[licensePopupHandled]\n\n    Set Output Variable\n    ...    outlookWindowTitle\n    ...    ${outlookTitle}\n\n    Set Output Variable\n    ...    composeWindowTitle\n    ...    ${composeTitle}\n\n    Set Output Variable\n    ...    deliveryDurationSeconds\n    ...    ${receiveResult}[deliveryDurationSeconds]\n\n    Set Output Variable\n    ...    totalE2EDurationSeconds\n    ...    ${totalDuration}"
}
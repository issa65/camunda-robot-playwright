{
  "id": "RPA_1ybo8d0",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    Camunda\nLibrary    OutlookLibrary\n\nTask Setup       Ensure Outlook Closed\nTask Teardown    Close Outlook\n\n\n*** Tasks ***\nOutlook Email Performance Test\n    ${testId}=                     Set Variable    ${EMPTY}\n    ${subject}=                    Set Variable    ${EMPTY}\n    ${recipient}=                  Set Variable    ahmad325issa@hotmail.com\n\n    ${workerUser}=                 Set Variable    ${EMPTY}\n    ${workerHost}=                 Set Variable    ${EMPTY}\n    ${workerIpAddress}=            Set Variable    ${EMPTY}\n\n    ${outlookTitle}=               Set Variable    ${EMPTY}\n    ${composeTitle}=               Set Variable    ${EMPTY}\n\n    ${onboardingHandled}=          Set Variable    ${False}\n    ${licensePopupHandled}=        Set Variable    ${False}\n    ${readonlyPopupHandled}=       Set Variable    ${False}\n\n    ${testResult}=                 Set Variable    PASS\n    ${errorType}=                  Set Variable    ${EMPTY}\n    ${errorMessage}=               Set Variable    ${EMPTY}\n\n    ${emailSent}=                  Set Variable    ${False}\n    ${emailReceived}=              Set Variable    ${False}\n\n    ${totalDuration}=              Set Variable    ${0.0}\n    ${deliveryDuration}=           Set Variable    ${0.0}\n\n    ${startupToLoadingSeconds}=    Set Variable    ${None}\n    ${loadingToMainSeconds}=       Set Variable    ${None}\n    ${startupToMainSeconds}=       Set Variable    ${None}\n    ${startupPath}=                Set Variable    ${EMPTY}\n\n    ${observedWindows}=            Evaluate    []\n\n    ${testStart}=    Evaluate    __import__('time').perf_counter()\n\n    TRY\n        # Testidentifikation\n        ${testId}=    Generate Test Id\n\n        # Worker-Metadaten\n        ${environment}=    Get Execution Environment\n\n        ${workerUser}=         Set Variable    ${environment}[username]\n        ${workerHost}=         Set Variable    ${environment}[hostname]\n        ${workerIpAddress}=    Set Variable    ${environment}[ipAddress]\n\n\n        # -----------------------------------------------------\n        # Outlook Cold Start messen\n        # Startkommando -> Loading Window -> Main Window\n        # -----------------------------------------------------\n        ${startupResult}=    Measure Outlook Startup\n        ...    timeout=30\n\n        ${startupToLoadingSeconds}=    Set Variable\n        ...    ${startupResult}[startupToLoadingSeconds]\n\n        ${loadingToMainSeconds}=    Set Variable\n        ...    ${startupResult}[loadingToMainSeconds]\n\n        ${startupToMainSeconds}=    Set Variable\n        ...    ${startupResult}[startupToMainSeconds]\n\n        ${startupPath}=    Set Variable\n        ...    ${startupResult}[startupPath]\n\n        ${observedWindows}=    Set Variable\n        ...    ${startupResult}[observedWindows]\n\n        ${outlookTitle}=    Set Variable\n        ...    ${startupResult}[windowTitle]\n\n\n        # Bekannte Office-/Outlook-Popups behandeln\n        ${uiPreparation}=    Prepare Outlook Ui\n\n        ${onboardingHandled}=    Set Variable\n        ...    ${uiPreparation}[onboardingHandled]\n\n        ${licensePopupHandled}=    Set Variable\n        ...    ${uiPreparation}[licensePopupHandled]\n\n        ${readonlyPopupHandled}=    Set Variable\n        ...    ${uiPreparation}[readonlyPopupHandled]\n\n\n        # -----------------------------------------------------\n        # E-Mail-E2E-Messung\n        # -----------------------------------------------------\n        ${e2eStart}=    Evaluate    __import__('time').perf_counter()\n\n        ${subject}=    Set Variable\n        ...    Camunda RPA E2E ${testId}\n\n        ${composeTitle}=    Open New Email\n\n        ${result}=    Fill Outlook Email\n        ...    recipient=${recipient}\n        ...    cc=${recipient}\n        ...    subject=${subject}\n        ...    body=Automatisierter Camunda RPA E2E Test. Test ID: ${testId}\n\n        ${sendResult}=    Send Outlook Email\n\n        ${emailSent}=    Set Variable\n        ...    ${sendResult}[sent]\n\n        ${receiveResult}=    Wait For Outlook Email\n        ...    ${subject}\n        ...    ${sendResult}[sendStarted]\n        ...    timeout=90\n\n        ${emailReceived}=    Set Variable\n        ...    ${receiveResult}[received]\n\n        ${deliveryDuration}=    Set Variable\n        ...    ${receiveResult}[deliveryDurationSeconds]\n\n        ${e2eEnd}=    Evaluate    __import__('time').perf_counter()\n\n        ${totalDuration}=    Evaluate\n        ...    round(${e2eEnd} - ${e2eStart}, 3)\n\n\n        IF    not $emailSent or not $emailReceived\n            ${testResult}=    Set Variable    FAIL\n            ${errorType}=     Set Variable    TestAssertionError\n            ${errorMessage}=  Set Variable    Outlook email send/receive validation failed.\n        END\n\n\n    EXCEPT    AS    ${error}\n        ${testResult}=    Set Variable    FAIL\n\n        ${errorMessage}=    Convert To String    ${error}\n\n        ${errorType}=    Evaluate\n        ...    str($errorMessage).split(':', 1)[0] if ':' in str($errorMessage) else 'TestExecutionError'\n\n        ${testEnd}=    Evaluate    __import__('time').perf_counter()\n\n        ${totalDuration}=    Evaluate\n        ...    round(${testEnd} - ${testStart}, 3)\n\n\n    FINALLY\n        Set Output Variable    testId    ${testId}\n        Set Output Variable    subject    ${subject}\n        Set Output Variable    recipient    ${recipient}\n\n        Set Output Variable    workerUser    ${workerUser}\n        Set Output Variable    workerHost    ${workerHost}\n        Set Output Variable    workerIpAddress    ${workerIpAddress}\n\n        Set Output Variable    testResult    ${testResult}\n        Set Output Variable    errorType    ${errorType}\n        Set Output Variable    errorMessage    ${errorMessage}\n\n        Set Output Variable    emailSent    ${emailSent}\n        Set Output Variable    emailReceived    ${emailReceived}\n\n        Set Output Variable\n        ...    onboardingPopupHandled\n        ...    ${onboardingHandled}\n\n        Set Output Variable\n        ...    licensePopupHandled\n        ...    ${licensePopupHandled}\n\n        Set Output Variable\n        ...    readonlyPopupHandled\n        ...    ${readonlyPopupHandled}\n\n        Set Output Variable\n        ...    outlookWindowTitle\n        ...    ${outlookTitle}\n\n        Set Output Variable\n        ...    composeWindowTitle\n        ...    ${composeTitle}\n\n        Set Output Variable\n        ...    deliveryDurationSeconds\n        ...    ${deliveryDuration}\n\n        Set Output Variable\n        ...    totalE2EDurationSeconds\n        ...    ${totalDuration}\n\n\n        # Outlook Startup Performance\n        Set Output Variable\n        ...    startupToLoadingSeconds\n        ...    ${startupToLoadingSeconds}\n\n        Set Output Variable\n        ...    loadingToMainSeconds\n        ...    ${loadingToMainSeconds}\n\n        Set Output Variable\n        ...    startupToMainSeconds\n        ...    ${startupToMainSeconds}\n\n        Set Output Variable\n        ...    startupPath\n        ...    ${startupPath}\n\n        # Diagnose: welche Fenster wurden tatsächlich gesehen?\n        Set Output Variable\n        ...    observedWindows\n        ...    ${observedWindows}\n\n    END"
}
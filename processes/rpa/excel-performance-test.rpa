{
  "id": "RPA_1bmmbl4",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    ExcelLibrary\nLibrary    Camunda\n\nTask Setup       Ensure Excel Closed\nTask Teardown    Close Excel\n\n*** Tasks ***\nExcel Technical Test\n    ${testRunId}=    Generate Test Id\n    ${environment}=    Get Execution Environment\n\n    ${workerUser}=         Set Variable    ${environment}[workerUser]\n    ${workerHost}=         Set Variable    ${environment}[workerHost]\n    ${workerIpAddress}=    Set Variable    ${environment}[workerIpAddress]\n\n    ${testResult}=    Set Variable    FAIL\n    ${status}=        Set Variable    ${EMPTY}\n    ${errorType}=     Set Variable    ${EMPTY}\n    ${errorMessage}=  Set Variable    ${EMPTY}\n\n    ${startupToLoadingSeconds}=    Set Variable    ${EMPTY}\n    ${loadingToMainSeconds}=       Set Variable    ${EMPTY}\n    ${startupToMainSeconds}=       Set Variable    ${EMPTY}\n    ${startupPath}=                Set Variable    ${EMPTY}\n\n    TRY\n        ${metrics}=    Measure Excel Startup    30    0.005\n\n        ${startupToLoadingSeconds}=    Set Variable    ${metrics}[startupToLoadingSeconds]\n        ${loadingToMainSeconds}=       Set Variable    ${metrics}[loadingToMainSeconds]\n        ${startupToMainSeconds}=       Set Variable    ${metrics}[startupToMainSeconds]\n        ${startupPath}=                Set Variable    ${metrics}[startupPath]\n\n        ${testResult}=    Set Variable    PASS\n\n    EXCEPT    AS    ${error}\n        ${errorType}=       Set Variable    ExcelTechnicalError\n        ${errorMessage}=    Set Variable    ${error}\n\n    FINALLY\n        Set Output Variable    testRunId                   ${testRunId}\n        Set Output Variable    workerUser                  ${workerUser}\n        Set Output Variable    workerHost                  ${workerHost}\n        Set Output Variable    workerIpAddress             ${workerIpAddress}\n\n        Set Output Variable    testResult                  ${testResult}\n        Set Output Variable    status                      ${status}\n\n        Set Output Variable    startupToLoadingSeconds     ${startupToLoadingSeconds}\n        Set Output Variable    loadingToMainSeconds        ${loadingToMainSeconds}\n        Set Output Variable    startupToMainSeconds        ${startupToMainSeconds}\n        Set Output Variable    startupPath                 ${startupPath}\n\n        Set Output Variable    errorType                   ${errorType}\n        Set Output Variable    errorMessage                ${errorMessage}\n    END"
}
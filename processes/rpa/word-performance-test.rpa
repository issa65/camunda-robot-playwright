{
  "id": "RPA_0ierx9m",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    WordLibrary\nLibrary    Camunda\n\nTask Setup       Ensure Word Closed\nTask Teardown    Close Word\n\n\n*** Tasks ***\nWord Startup Performance Test\n    ${testRunId}=    Generate Test Id\n    ${env}=          Get Execution Environment\n\n    ${workerUser}=         Set Variable    ${env}[workerUser]\n    ${workerHost}=         Set Variable    ${env}[workerHost]\n    ${workerIpAddress}=    Set Variable    ${env}[workerIpAddress]\n\n    ${testResult}=      Set Variable    FAIL\n    ${status}=          Set Variable    ${EMPTY}\n    ${errorType}=       Set Variable    ${EMPTY}\n    ${errorMessage}=    Set Variable    ${EMPTY}\n\n    ${startupToLoadingSeconds}=    Set Variable    ${EMPTY}\n    ${loadingToMainSeconds}=       Set Variable    ${EMPTY}\n    ${startupToMainSeconds}=       Set Variable    ${EMPTY}\n    ${startupPath}=                Set Variable    ${EMPTY}\n\n    TRY\n        ${result}=    Measure Word Startup\n\n        ${startupToLoadingSeconds}=    Set Variable\n        ...    ${result}[startupToLoadingSeconds]\n\n        ${loadingToMainSeconds}=    Set Variable\n        ...    ${result}[loadingToMainSeconds]\n\n        ${startupToMainSeconds}=    Set Variable\n        ...    ${result}[startupToMainSeconds]\n\n        ${startupPath}=    Set Variable\n        ...    ${result}[startupPath]\n\n        ${testResult}=    Set Variable    PASS\n\n        Log    Word startup measurement successful.\n        Log    Startup to loading: ${startupToLoadingSeconds}\n        Log    Loading to main: ${loadingToMainSeconds}\n        Log    Startup to main: ${startupToMainSeconds}\n        Log    Startup path: ${startupPath}\n\n    EXCEPT    AS    ${error}\n        ${testResult}=      Set Variable    FAIL\n        ${errorType}=       Set Variable    TestExecutionError\n        ${errorMessage}=    Set Variable    ${error}\n\n        Log    Word startup measurement failed: ${error}\n\n    FINALLY\n        Set Output Variable    testRunId                  ${testRunId}\n        Set Output Variable    workerUser                 ${workerUser}\n        Set Output Variable    workerHost                 ${workerHost}\n        Set Output Variable    workerIpAddress            ${workerIpAddress}\n\n        Set Output Variable    testResult                 ${testResult}\n        Set Output Variable    status                     ${status}\n        Set Output Variable    errorType                  ${errorType}\n        Set Output Variable    errorMessage               ${errorMessage}\n\n        Set Output Variable    startupToLoadingSeconds    ${startupToLoadingSeconds}\n        Set Output Variable    loadingToMainSeconds       ${loadingToMainSeconds}\n        Set Output Variable    startupToMainSeconds       ${startupToMainSeconds}\n        Set Output Variable    startupPath                ${startupPath}\n    END"
}
{
  "id": "RPA_1m16cqu",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    WordLibrary\nLibrary    Camunda\n\nTask Setup       Ensure Word Closed\nTask Teardown    Close Word\n\n\n*** Tasks ***\nWord Basic Functional Test\n    ${testRunId}=    Generate Test Id\n    ${env}=          Get Execution Environment\n\n    ${workerUser}=         Set Variable    ${env}[workerUser]\n    ${workerHost}=         Set Variable    ${env}[workerHost]\n    ${workerIpAddress}=    Set Variable    ${env}[workerIpAddress]\n\n    ${testResult}=      Set Variable    FAIL\n    ${status}=          Set Variable    ${EMPTY}\n    ${errorType}=       Set Variable    ${EMPTY}\n    ${errorMessage}=    Set Variable    ${EMPTY}\n    ${durationSeconds}=    Set Variable    ${EMPTY}\n\n    ${expectedText}=    Set Variable    Camunda RPA Word Test\n\n    ${startTime}=    Evaluate    time.perf_counter()    modules=time\n\n    TRY\n        Open Word\n\n        Write Word Text    ${expectedText}\n\n        ${actualText}=    Read Word Text\n\n        Should Contain    ${actualText}    ${expectedText}\n\n        ${testResult}=    Set Variable    PASS\n        ${status}=        Set Variable    FUNCTIONAL_OK\n\n    EXCEPT    AS    ${error}\n        ${testResult}=      Set Variable    FAIL\n        ${status}=          Set Variable    FUNCTIONAL_ERROR\n        ${errorType}=       Set Variable    TestExecutionError\n        ${errorMessage}=    Set Variable    ${error}\n\n    FINALLY\n        ${endTime}=    Evaluate    time.perf_counter()    modules=time\n\n        ${durationSeconds}=    Evaluate\n        ...    round(float($endTime) - float($startTime), 3)\n\n        Set Output Variable    testRunId              ${testRunId}\n        Set Output Variable    workerUser             ${workerUser}\n        Set Output Variable    workerHost             ${workerHost}\n        Set Output Variable    workerIpAddress        ${workerIpAddress}\n\n        Set Output Variable    testResult             ${testResult}\n        Set Output Variable    status                 ${status}\n        Set Output Variable    errorType              ${errorType}\n        Set Output Variable    errorMessage           ${errorMessage}\n        Set Output Variable    durationSeconds        ${durationSeconds}\n\n        Set Output Variable    expectedText           ${expectedText}\n    END"
}
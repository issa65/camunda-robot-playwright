{
  "id": "RPA_08ihbo4",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "\n*** Settings ***\nLibrary    Browser\nLibrary    String\nLibrary    RequestsLibrary\n\n*** Variables ***\n${BASE_URL}       http://192.168.178.30:5173\n${CUSTOMER}       Testkunde E2E\n${QUANTITY}       2\n\n*** Test Cases ***\nTC-003 Auftrag erstellen und Camunda-Verarbeitung pruefen\n    # 1. Eindeutige Auftragsnummer erzeugen\n    ${id}=    Generate Random String    8    [NUMBERS]\n    ${orderNumber}=    Set Variable    ORD-${id}\n\n    # 2. Browser starten\n    New Browser    chromium    headless=${FALSE}    channel=chrome\n    New Context\n    New Page    ${BASE_URL}\n\n    # 3. Auftrag über React erstellen\n    Fill Text    [data-testid=\"order-number\"]    ${orderNumber}\n    Fill Text    [data-testid=\"customer\"]    ${CUSTOMER}\n    Fill Text    [data-testid=\"quantity\"]    ${QUANTITY}\n\n    Click    [data-testid=\"submit-order\"]\n\n    # 4. Erfolgsmeldung im React-Frontend prüfen\n    Wait For Elements State    [data-testid=\"order-success\"]    visible\n    Get Text    [data-testid=\"order-success\"]    contains    ${orderNumber}\n    Get Text    [data-testid=\"order-success\"]    contains    ${CUSTOMER}\n    Get Text    [data-testid=\"order-success\"]    contains    Menge: ${QUANTITY}\n\n    # 5. Warten, bis Camunda den Auftrag abgeschlossen hat\n    Wait Until Keyword Succeeds    30s    2s\n    ...    Auftrag Im Backend Pruefen    ${orderNumber}\n\n    Log To Console    TC-003 PASS: Auftrag ${orderNumber} wurde durch Camunda abgeschlossen\n\n    Close Browser\n\n*** Keywords ***\nAuftrag Im Backend Pruefen\n    [Arguments]    ${orderNumber}\n\n    # Aktuellen Auftrag aus Spring Boot abrufen\n    ${response}=    GET\n    ...    ${BASE_URL}/api/orders/${orderNumber}\n    ...    expected_status=200\n\n    ${order}=    Evaluate    $response.json()\n\n    # Gespeicherte Daten vergleichen\n    Should Be Equal    ${order}[orderNumber]    ${orderNumber}\n    Should Be Equal    ${order}[customer]    ${CUSTOMER}\n    Should Be Equal As Integers    ${order}[quantity]    ${QUANTITY}\n\n    # Entscheidend: Camunda muss den Status aktualisiert haben\n    Should Be Equal    ${order}[status]    COMPLETED\n\n    Log To Console    Backend-Status: ${order}[status]\n"
}
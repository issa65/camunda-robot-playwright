{
  "id": "RPA_15wwkoi",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    Browser\nLibrary    Camunda\nLibrary    Collections\n\n*** Variables ***\n${URL}           https://rahulshettyacademy.com/loginpagePractise/\n${WRONG_USER}    rahulshetty\n${VALID_USER}    rahulshettyacademy\n${PASSWORD}      Learning@830$3mK2\n\n*** Tasks ***\nBrowser Context Playwright Test\n    [Teardown]    Close Browser\n\n    New Browser    chromium    headless=False\n    New Context\n    New Page    ${URL}\n\n    ${pageTitle}=    Get Title\n    Log    Page title: ${pageTitle}\n\n    # Falscher Login\n    Fill Text    css=#username    ${WRONG_USER}\n    Fill Text    css=input[type=\"password\"]    ${PASSWORD}\n    Click    css=#signInBtn\n\n    # Entspricht Playwright:\n    # expect(...).toContainText('Incorrect')\n    Get Text    css=[style*=\"block\"]    contains    Incorrect\n\n    # Richtiger Login\n    Fill Text    css=#username    ${VALID_USER}\n    Click    css=#signInBtn\n\n    # Auf Produktkarten warten\n    Wait For Elements State\n    ...    css=.card-body a >> nth=0\n    ...    visible\n    ...    15s\n\n    ${count}=    Get Element Count    css=.card-body a\n    ${titles}=    Create List\n\n    FOR    ${index}    IN RANGE    ${count}\n        ${title}=    Get Text    css=.card-body a >> nth=${index}\n        Append To List    ${titles}    ${title}\n    END\n\n    Log    Card titles: ${titles}\n\n    Set Output Variable    pageTitle    ${pageTitle}\n    Set Output Variable    cardTitles    ${titles}"
}
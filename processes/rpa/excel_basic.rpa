{
  "id": "RPA_1hne1c4",
  "name": "",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "script": "*** Settings ***\nLibrary    ExcelLibrary\nLibrary    Camunda\n\nTask Setup       Ensure Excel Closed\nTask Teardown    Close Excel\n\n*** Tasks ***\nExcel Functional Test\n    ${testRunId}=    Generate Test Id\n    ${environment}=    Get Execution Environment\n\n    ${workerUser}=         Set Variable    ${environment}[workerUser]\n    ${workerHost}=         Set Variable    ${environment}[workerHost]\n    ${workerIpAddress}=    Set Variable    ${environment}[workerIpAddress]\n\n    ${testResult}=      Set Variable    FAIL\n    ${errorType}=       Set Variable    ${EMPTY}\n    ${errorMessage}=    Set Variable    ${EMPTY}\n\n    ${start}=    Evaluate    __import__('time').perf_counter()\n\n    TRY\n        ${title}=    Open Excel\n\n        Write Excel Cell    A1    Camunda\n        Write Excel Cell    B1    RPA\n        Write Excel Cell    A2    12345\n\n        ${a1}=    Read Excel Cell    A1\n        ${b1}=    Read Excel Cell    B1\n        ${a2}=    Read Excel Cell    A2\n\n        Should Be Equal As Strings    ${a1}[value]    Camunda\n        Should Be Equal As Strings    ${b1}[value]    RPA\n        Should Be Equal As Strings    ${a2}[value]    12345\n\n        ${testResult}=    Set Variable    PASS\n\n    EXCEPT    AS    ${error}\n        ${errorMessage}=    Set Variable    ${error}\n        ${errorType}=       Set Variable    ExcelFunctionalError\n\n    FINALLY\n        ${end}=    Evaluate    __import__('time').perf_counter()\n        ${durationSeconds}=    Evaluate    round(${end} - ${start}, 3)\n\n        Set Output Variable    testRunId              ${testRunId}\n        Set Output Variable    workerUser             ${workerUser}\n        Set Output Variable    workerHost             ${workerHost}\n        Set Output Variable    workerIpAddress        ${workerIpAddress}\n\n        Set Output Variable    testResult             ${testResult}\n        Set Output Variable    errorType              ${errorType}\n        Set Output Variable    errorMessage           ${errorMessage}\n        Set Output Variable    durationSeconds        ${durationSeconds}\n    END"
}